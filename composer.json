{
    "name": "faveroo/laravel-repro",
    "description": "Turn real Laravel failures into reproducible regression tests.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Faveroo\\LaravelRepro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Faveroo\\LaravelRepro\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "faveroo",
            "email": "gabriel290974@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Faveroo\\LaravelRepro\\LaravelReproServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.4.1 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "suggest": {
        "pestphp/pest": "Required to execute generated Pest regression tests.",
        "pestphp/pest-plugin-laravel": "Required to run generated Pest tests in Laravel applications."
    },
    "scripts": {
        "test": "pest --no-tia",
        "test:coverage": "pest --coverage --no-tia"
    },
    "keywords": [
        "laravel",
        "pest",
        "testing",
        "regression-testing",
        "debugging",
        "exceptions"
    ],
    "homepage": "https://github.com/faveroo/laravel-repro",
    "support": {
        "issues": "https://github.com/faveroo/laravel-repro/issues",
        "source": "https://github.com/faveroo/laravel-repro"
    }
}
